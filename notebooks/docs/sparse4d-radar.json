      "remotePath": "notebooks/assets/note-12f742de-767d-496b-ba79-0a5e0f754e70/sparse4d-radar-architecture-20261125032940-j9qas.html",
      "remoteUrl": "notebooks/assets/note-12f742de-767d-496b-ba79-0a5e0f754e70/sparse4d-radar-architecture-20261125032940-j9qas.html",
